# Local Laser Stack (docker compose up -d)
LASER_CONNECTION_STRING=iggy:laser@127.0.0.1:8090
# LaserData Cloud instead: user:password@your-deployment.laserdata.cloud (or token@host)

# The stream; deleted and created again at startup
DESK_STREAM=travel-desk
# 1 keeps the stream at startup
DESK_KEEP=0
DESK_PORT=8010

# How long the quote panel waits for every airline and hotel, and the car hire contract
DESK_QUOTE_DEADLINE_MS=2500
DESK_CAR_DEADLINE_MS=2000
# How long a vote stays open
DESK_VOTE_WINDOW_MS=600000
# Rooms of each type each hotel has free at startup
DESK_ROOMS=4

# The unattended demo loop: 1 starts it with the server. Seconds between
# trips, seconds a card shows its picks, and seconds before a vote decides.
DESK_DEMO=0
DESK_DEMO_PAUSE=8
DESK_DEMO_PICK_DELAY=4
DESK_DEMO_APPROVE_DELAY=4

# Travel policy
DESK_APPROVAL_OVER=1500
DESK_HOTEL_CAP=400

# The auditor's Iggy user, created on first run. Local test credentials only.
DESK_AUDITOR_USER=travel-auditor
DESK_AUDITOR_PASSWORD=travel-auditor-local
